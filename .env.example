# ============================================================
#  clinic-user-service — variables de entorno
#  Copiar a .env y completar los valores
#  NUNCA commitear el .env real
# ============================================================

# ---- Servidor -----------------------------------------------
PORT=3002
NODE_ENV=development

# ---- Base de datos PostgreSQL (propia del user-service) -----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=user_svc_user
DB_PASSWORD=changeme
DB_NAME=user_db
DB_SSL=false

# ---- Swagger (solo development) -----------------------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme

# ---- Orígenes permitidos para CORS --------------------------
ALLOWED_ORIGINS=http://localhost:4200
